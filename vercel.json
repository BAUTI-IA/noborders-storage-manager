{
  "crons": [
    {
      "path": "/api/agent-hub",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/verizon-gps",
      "destination": "/api/geocode?fleet=webhook&provider=verizon"
    },
    {
      "source": "/api/motive-gps",
      "destination": "/api/geocode?fleet=webhook&provider=motive"
    },
    {
      "source": "/api/wati-webhook",
      "destination": "/api/whatsapp-webhook?provider=wati"
    },
    {
      "source": "/api/inbound-email",
      "destination": "/api/agent-hub?action=inbound_email"
    }
  ]
}
